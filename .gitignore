# Python build artifacts — never commit these
*.egg-info/
dist/
build/
*.egg
*.whl

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# uv / pip
pip-log.txt
pip-delete-this-directory.txt

# Test / output artifacts (project-specific)
output.rtf
output.txt
test-inverted.rtf

# Web build artifacts
web/.next/
web/node_modules/
web/out/
web/.env.local
web/.env

# Extension build artifacts
extension/*.zip
extension/crx/

# macOS
.DS_Store
.AppleDouble

# VS Code
.vscode/
*.code-workspace

# Environment variables / secrets
.env
.env.*output-inverted.*
output-inverted.*
